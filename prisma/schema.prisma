generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lugar {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  nome                    String
  categoria               String
  subcategoria            String?
  descricaoCurta          String
  descricaoCompleta       String   @db.Text
  imagem                  String
  imagemAlt               String
  endereco                String?
  enderecoGoogleMaps      String?
  enderecoGoogleMapsLabel String?
  enderecoGoogleMaps2     String?
  enderecoGoogleMaps2Label String?
  telefone                String?
  instagram               String?
  instagramReview         String?
  website                 String?
  horarioFuncionamento    String?
  faixaPreco              Int?     // 1, 2, 3, 4
  destaque                Boolean  @default(false)
  ordem                   Int      @default(0)
  
  cupons                  Cupom[]
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Cupom {
  id          String   @id @default(cuid())
  lugarId     String
  codigo      String
  descricao   String
  validade    DateTime?
  termos      String?
  ativo       Boolean  @default(true)
  
  lugar       Lugar    @relation(fields: [lugarId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
