# Site Configuration
NEXT_PUBLIC_SITE_URL=https://reviewsporisabel.com.br

# Social Media
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/reviewsporisabel
NEXT_PUBLIC_EMAIL=contato@reviewsporisabel.com.br

# SEO Verification (opcional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

# Google Maps API
# Obtenha sua chave em: https://console.cloud.google.com/apis/credentials
# Cloudinary Config
# Obtenha o Cloud Name em: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Crie um Unsigned Upload Preset em: Settings > Upload > Upload Presets
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default_reviews
# Chaves API (Necessárias para a limpeza automática de imagens órfãs)
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
